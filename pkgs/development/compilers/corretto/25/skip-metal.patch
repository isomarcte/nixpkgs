diff --git a/make/autoconf/toolchain.m4 b/make/autoconf/toolchain.m4
index f3ef44d..e147439 100644
--- a/make/autoconf/toolchain.m4
+++ b/make/autoconf/toolchain.m4
@@ -697,10 +697,8 @@ AC_DEFUN_ONCE([TOOLCHAIN_DETECT_TOOLCHAIN_EXTRA],
       test_metal=`$METAL --version 2>&1`
       if test $? -ne 0; then
         AC_MSG_RESULT([no])
-        AC_MSG_NOTICE([A full XCode is required to build the JDK (not only command line tools)])
-        AC_MSG_NOTICE([If you have XCode installed, you might need to reset the Xcode active developer directory])
-        AC_MSG_NOTICE([using 'sudo xcode-select -r'])
-        AC_MSG_ERROR([XCode tool 'metal' neither found in path nor with xcrun])
+        AC_MSG_WARN([XCode tool 'metal' neither found in path nor with xcrun; disabling the Metal-accelerated Java2D pipeline])
+        METAL=
       else
         AC_MSG_RESULT([yes, will be using '$METAL'])
       fi
@@ -713,7 +711,8 @@ AC_DEFUN_ONCE([TOOLCHAIN_DETECT_TOOLCHAIN_EXTRA],
       test_metallib=`$METALLIB --version 2>&1`
       if test $? -ne 0; then
         AC_MSG_RESULT([no])
-        AC_MSG_ERROR([XCode tool 'metallib' neither found in path nor with xcrun])
+        AC_MSG_WARN([XCode tool 'metallib' neither found in path nor with xcrun; disabling the Metal-accelerated Java2D pipeline])
+        METALLIB=
       else
         AC_MSG_RESULT([yes, will be using '$METALLIB'])
       fi
diff --git a/make/modules/java.desktop/lib/ClientLibraries.gmk b/make/modules/java.desktop/lib/ClientLibraries.gmk
index c9eb87f..141f982 100644
--- a/make/modules/java.desktop/lib/ClientLibraries.gmk
+++ b/make/modules/java.desktop/lib/ClientLibraries.gmk
@@ -429,6 +429,11 @@ ifeq ($(call isTargetOs, macosx), true)
   ## Build libosxui
   ##############################################################################
 
+  # Only compile the Metal shaders (and thus require Xcode's `metal`/
+  # `metallib`, which aren't available in a sandboxed Nix build) when they
+  # were actually found by configure. libosxui itself still builds without
+  # them; it just ships without Metal-accelerated Java2D rendering.
+  ifneq ($(METAL), )
   SHADERS_SRC := \
       $(TOPDIR)/src/java.desktop/macosx/native/libawt_lwawt/java2d/metal/shaders.metal
   SHADERS_SUPPORT_DIR := $(SUPPORT_OUTPUTDIR)/native/java.desktop/libosxui
@@ -454,6 +459,7 @@ ifeq ($(call isTargetOs, macosx), true)
   ))
 
   TARGETS += $(SHADERS_LIB)
+  endif
 
   $(eval $(call SetupJdkLibrary, BUILD_LIBOSXUI, \
       NAME := osxui, \
@@ -475,7 +481,9 @@ ifeq ($(call isTargetOs, macosx), true)
 
   TARGETS += $(BUILD_LIBOSXUI)
 
+  ifneq ($(METAL), )
   $(BUILD_LIBOSXUI): $(SHADERS_LIB)
+  endif
 endif
 
 ################################################################################

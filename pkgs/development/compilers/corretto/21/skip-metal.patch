       else
         AC_MSG_RESULT([yes, will be using '$METAL'])
       fi
@@ -776,7 +777,8 @@ AC_DEFUN_ONCE([TOOLCHAIN_DETECT_TOOLCHAIN_EXTRA],
       test_metallib=`$METALLIB --version 2>&1`
       if test $? -ne 0; then
         AC_MSG_RESULT([no])

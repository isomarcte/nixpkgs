diff --git a/make/autoconf/toolchain.m4 b/make/autoconf/toolchain.m4
index a2b576a..df1f471 100644
--- a/make/autoconf/toolchain.m4
+++ b/make/autoconf/toolchain.m4
@@ -763,7 +763,8 @@ AC_DEFUN_ONCE([TOOLCHAIN_DETECT_TOOLCHAIN_EXTRA],
       test_metal=`$METAL --version 2>&1`
       if test $? -ne 0; then
         AC_MSG_RESULT([no])
-        AC_MSG_ERROR([XCode tool 'metal' neither found in path nor with xcrun])
+        AC_MSG_WARN([XCode tool 'metal' neither found in path nor with xcrun; disabling the Metal-accelerated Java2D pipeline])

@@ -912,6 +912,11 @@ endif
 ################################################################################
 
 ifeq ($(call isTargetOs, macosx), true)
+  # Only compile the Metal shaders (and thus require Xcode's `metal`/
+  # `metallib`, which aren't available in a sandboxed Nix build) when they
+  # were actually found by configure. libosxui itself still builds without
+  # them; it just ships without Metal-accelerated Java2D rendering.
+  ifneq ($(METAL), )
   SHADERS_SRC := $(TOPDIR)/src/java.desktop/macosx/native/libawt_lwawt/java2d/metal/shaders.metal
   SHADERS_SUPPORT_DIR := $(SUPPORT_OUTPUTDIR)/native/java.desktop/libosxui
   SHADERS_AIR := $(SHADERS_SUPPORT_DIR)/shaders.air
@@ -936,6 +941,7 @@ ifeq ($(call isTargetOs, macosx), true)
   ))
 
   TARGETS += $(SHADERS_LIB)
+  endif
 
   $(eval $(call SetupJdkLibrary, BUILD_LIBOSXUI, \
       NAME := osxui, \
@@ -960,7 +966,9 @@ ifeq ($(call isTargetOs, macosx), true)
   ))
 
   TARGETS += $(BUILD_LIBOSXUI)
+  ifneq ($(METAL), )
   $(BUILD_LIBOSXUI): $(SHADERS_LIB)
+  endif
 
   $(BUILD_LIBOSXUI): $(BUILD_LIBAWT)
 
